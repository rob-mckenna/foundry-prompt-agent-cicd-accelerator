{
  "$schema": "../../../schemas/environment-overlay.schema.json",
  "schemaVersion": "1.0.0",
  "environment": "test",
  "model": {
    "deploymentName": "gpt-4o-mini",
    "parameters": {
      "temperature": 0.2
    }
  },
  "toolOverrides": {
    "knowledge-search": {
      "config": {
        "indexName": "kb-test-v1",
        "topK": 5
      }
    }
  },
  "variables": {
    "SEARCH_CONNECTION_ID": "/subscriptions/${env:AZURE_SUBSCRIPTION_ID}/resourceGroups/rg-foundry-agents-test/providers/Microsoft.CognitiveServices/accounts/aifagentstest/projects/proj-agents-test/connections/kb-search",
    "SEARCH_INDEX_NAME": "kb-test-v1",
    "VECTOR_STORE_ID": "${env:VECTOR_STORE_ID}"
  },
  "metadata": {
    "environment": "test"
  },
  "deploymentGates": {
    "requireEvaluationPass": true,
    "requireSmokeTestPass": true,
    "requireRegressionPass": true,
    "minimumEvaluationScore": 0.85
  }
}
