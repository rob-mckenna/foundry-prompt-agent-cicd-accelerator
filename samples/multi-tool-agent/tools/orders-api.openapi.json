{
  "openapi": "3.0.3",
  "info": {
    "title": "Orders API",
    "description": "Read-only order status lookup for the support agent. Replace with your own specification.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://orders.example.com/v1",
      "description": "Replace with the environment-specific base URL. Use one connection per environment rather than editing this file."
    }
  ],
  "paths": {
    "/orders/{orderId}": {
      "get": {
        "operationId": "getOrderStatus",
        "summary": "Returns the current status of one order.",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "description": "Order identifier supplied by the customer.",
            "schema": {
              "type": "string",
              "pattern": "^[A-Z]{2}-[0-9]{6}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Order found.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["orderId", "status"],
                  "properties": {
                    "orderId": { "type": "string" },
                    "status": {
                      "type": "string",
                      "enum": ["received", "processing", "shipped", "delivered", "cancelled"]
                    },
                    "estimatedDelivery": { "type": "string", "format": "date" },
                    "carrier": { "type": "string" }
                  }
                }
              }
            }
          },
          "404": { "description": "Order not found." }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "Supplied by the Foundry project connection at call time. Never place a key value in this file."
      }
    }
  },
  "security": [
    {
      "apiKeyAuth": []
    }
  ]
}
