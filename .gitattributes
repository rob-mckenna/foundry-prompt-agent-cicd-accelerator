# Normalise line endings so that package checksums are stable across Windows and Linux agents.
* text=auto eol=lf

*.ps1   text eol=lf
*.psm1  text eol=lf
*.psd1  text eol=lf
*.json  text eol=lf
*.jsonl text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.bicep text eol=lf
*.bicepparam text eol=lf
*.tf    text eol=lf
*.tfvars text eol=lf
*.hcl   text eol=lf

*.png  binary
*.jpg  binary
*.zip  binary
