{
  "$schema": "../../schemas/tool-definition.schema.json",
  "schemaVersion": "1.0.0",
  "id": "uploaded-documents",
  "type": "file_search",
  "displayName": "Uploaded document search",
  "description": "Searches documents uploaded to a project vector store.",
  "config": {
    "vectorStoreIds": [
      "${env:VECTOR_STORE_ID}"
    ]
  },
  "governance": {
    "dataEgress": "none",
    "requiresSecurityReview": false
  }
}
