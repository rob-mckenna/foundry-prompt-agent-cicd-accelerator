{
  "$schema": "../../../schemas/environment-overlay.schema.json",
  "schemaVersion": "1.0.0",
  "environment": "uat",
  "model": {
    "deploymentName": "gpt-4o",
    "parameters": {
      "temperature": 0.2
    }
  },
  "toolOverrides": {
    "knowledge-search": {
      "config": {
        "indexName": "ops-uat-v1"
      }
    },
    "code-interpreter": {
      "enabled": false
    },
    "web-grounding": {
      "enabled": false
    }
  },
  "variables": {
    "SEARCH_CONNECTION_ID": "/subscriptions/${env:AZURE_SUBSCRIPTION_ID}/resourceGroups/rg-foundry-agents-uat/providers/Microsoft.CognitiveServices/accounts/aifagentsuat/projects/proj-agents-uat/connections/ops-search",
    "SEARCH_INDEX_NAME": "ops-uat-v1",
    "ORDERS_API_CONNECTION_ID": "/subscriptions/${env:AZURE_SUBSCRIPTION_ID}/resourceGroups/rg-foundry-agents-uat/providers/Microsoft.CognitiveServices/accounts/aifagentsuat/projects/proj-agents-uat/connections/orders-api",
    "FUNCTION_QUEUE_ENDPOINT": "https://stfndagentsuat.queue.core.windows.net"
  },
  "secretRefs": {
    "ORDERS_API_KEY": "@Microsoft.KeyVault(VaultName=kv-fnd-agents-uat;SecretName=orders-api-key)"
  },
  "metadata": {
    "environment": "uat"
  },
  "deploymentGates": {
    "requireEvaluationPass": true,
    "requireSmokeTestPass": true,
    "requireRegressionPass": true,
    "minimumEvaluationScore": 0.9
  }
}
