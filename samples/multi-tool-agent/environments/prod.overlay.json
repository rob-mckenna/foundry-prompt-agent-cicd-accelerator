{
  "$schema": "../../../schemas/environment-overlay.schema.json",
  "schemaVersion": "1.0.0",
  "environment": "prod",
  "model": {
    "deploymentName": "gpt-4o",
    "parameters": {
      "temperature": 0.1
    }
  },
  "toolOverrides": {
    "knowledge-search": {
      "config": {
        "indexName": "ops-prod-v2"
      }
    },
    "code-interpreter": {
      "enabled": false
    },
    "web-grounding": {
      "enabled": false
    }
  },
  "variables": {
    "SEARCH_CONNECTION_ID": "/subscriptions/${env:AZURE_SUBSCRIPTION_ID}/resourceGroups/rg-foundry-agents-prod/providers/Microsoft.CognitiveServices/accounts/aifagentsprod/projects/proj-agents-prod/connections/ops-search",
    "SEARCH_INDEX_NAME": "ops-prod-v2",
    "ORDERS_API_CONNECTION_ID": "/subscriptions/${env:AZURE_SUBSCRIPTION_ID}/resourceGroups/rg-foundry-agents-prod/providers/Microsoft.CognitiveServices/accounts/aifagentsprod/projects/proj-agents-prod/connections/orders-api",
    "FUNCTION_QUEUE_ENDPOINT": "https://stfndagentsprod.queue.core.windows.net"
  },
  "secretRefs": {
    "ORDERS_API_KEY": "@Microsoft.KeyVault(VaultName=kv-fnd-agents-prod;SecretName=orders-api-key)"
  },
  "metadata": {
    "environment": "prod",
    "change_record": "${env:CHANGE_RECORD_ID}"
  },
  "deploymentGates": {
    "requireEvaluationPass": true,
    "requireSmokeTestPass": true,
    "requireRegressionPass": true,
    "minimumEvaluationScore": 0.9
  }
}
